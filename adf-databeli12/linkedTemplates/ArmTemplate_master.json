{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-databeli12"
		},
		"ls_adb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1025-132130-8fqw87mj"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://databelistoacc.dfs.core.windows.net/"
		},
		"ls_azuresqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "databeli-server.database.windows.net"
		},
		"ls_azuresqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "databeli-database"
		},
		"ls_azuresqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "databeli"
		},
		"ls_postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-wispy-lab-azs8lip7-pooler.c-3.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"ls_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://databeli-vault.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-databeli12_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_vault_properties_typeProperties_baseUrl')]"
					},
					"ls_adb_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_adb_properties_typeProperties_existingClusterId')]"
					},
					"ls_azuresqldb_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_server')]"
					},
					"ls_azuresqldb_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_database')]"
					},
					"ls_azuresqldb_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldb_properties_typeProperties_userName')]"
					},
					"ls_postgres_properties_typeProperties_server": {
						"value": "[parameters('ls_postgres_properties_typeProperties_server')]"
					},
					"ls_postgres_properties_typeProperties_database": {
						"value": "[parameters('ls_postgres_properties_typeProperties_database')]"
					},
					"ls_postgres_properties_typeProperties_username": {
						"value": "[parameters('ls_postgres_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}